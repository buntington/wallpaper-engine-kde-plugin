# Builds this checkout (scene text, wallpaper properties, audio spectrum).
# Use:  cd pkg/arch && makepkg -si

pkgname=plasma6-wallpapers-wallpaper-engine-scenetext
pkgver=0.5.4
pkgrel=1
pkgdesc="Wallpaper Engine KDE plugin with scene text, wallpaper properties and audio support"
arch=('x86_64')
url="https://github.com/catsout/wallpaper-engine-kde-plugin"
license=('GPL-2.0-only')
depends=("gcc-libs" "glibc" "kcmutils" "kirigami" "libglvnd" "libplasma"
         "lz4" "qt6-base" "vulkan-icd-loader" "fontconfig"
         "kdeclarative" "plasma-workspace" "plasma5support"
         "python" "python-websockets" "qt6-5compat"
         "qt6-declarative" "qt6-multimedia" "qt6-webchannel"
         "qt6-webengine" "qt6-websockets" "gst-libav")
makedepends=("cmake" "extra-cmake-modules" "git" "mpv" "ninja" "vulkan-headers")
provides=("plasma6-wallpapers-wallpaper-engine")
conflicts=("plasma6-wallpapers-wallpaper-engine" "plasma6-wallpapers-wallpaper-engine-git")

# The repository this PKGBUILD lives in.
_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

pkgver() {
    printf "0.5.4.r%s.%s" "$(git -C "$_root" rev-list --count HEAD)" "$(date +%Y%m%d%H%M)"
}

build() {
    cmake -B build -S "$_root" -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DQT_MAJOR_VERSION=6 \
        -DBUILD_QML=ON \
        -DUSE_PLASMAPKG=OFF
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
}
